    "{{CONTACT_EMAIL}}": "Your email address (e.g., 'billing@example.com')"
  },
  "automation_rules": {
    "rule_1": {
      "trigger": "invoice_created",
      "days_before_due": 7,
      "template": "01-reminder-7-days.html",
      "action": "send_email"
    },
    "rule_2": {
      "trigger": "invoice_due",
      "days_offset": 0,
      "template": "02-due-today.html",
      "action": "send_email"
    },
    "rule_3": {
      "trigger": "invoice_overdue",
      "days_offset": 3,
      "template": "03-overdue-1st-notice.html",
      "action": "send_email"
    },
    "rule_4": {
      "trigger": "invoice_overdue",
      "days_offset": 15,
      "template": "04-overdue-2nd-notice.html",
      "action": "send_email"
    },
    "rule_5": {
      "trigger": "invoice_overdue",
      "days_offset": 30,
      "template": "05-final-notice.html",
      "action": "send_email"
    },
    "rule_6": {
      "trigger": "invoice_overdue",
      "days_offset": 33,
      "template": null,
      "action": "escalate_to_collections"
    }
  },
