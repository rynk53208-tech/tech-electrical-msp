  "placeholder_reference": {
    "{{CLIENT_NAME}}": "Customer's name or company name (e.g., 'Acme Corp')",
    "{{INVOICE_NUMBER}}": "Invoice ID (e.g., 'INV-2026-001')",
    "{{AMOUNT}}": "Original invoice amount (e.g., '$2,500.00')",
    "{{DUE_DATE}}": "Original due date (e.g., '2026-03-26')",
    "{{DAYS_OVERDUE}}": "Number of days past due (e.g., '4')",
    "{{LATE_FEES}}": "Late fees or interest charged (e.g., '$340.00')",
    "{{TOTAL_AMOUNT}}": "Total amount due including fees (e.g., '$3,740.00')",
